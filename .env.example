# Copy this file to .env and fill in ONE of the two keys below.
# .env is in .gitignore — it never gets committed. Loaded automatically by
# pipeline/config.py on every run; no need to `export` anything yourself.

# Preferred — real structured-output calls (response_format=json_schema,
# strict mode), used first if set. Get one at platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional — override the default model (gpt-5.1). gpt-5.1-mini is
# meaningfully cheaper and plenty for short SEO metadata/copy — see
# README.md "Estimated API usage per run" for the cost difference.
# OPENAI_MODEL=gpt-5.1-mini

# Free-tier fallback for testing, used only if OPENAI_API_KEY is empty.
# Get one at https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=

# Optional — override Groq's default model (llama-3.3-70b-versatile).
# llama-3.1-8b-instant has a higher free-tier daily quota at lower quality.
# GROQ_MODEL=llama-3.1-8b-instant

# --- GitHub CMS publishing (Agent 4) ---
# A classic or fine-grained PAT with Contents + Pull requests read/write on
# the one repo below. Agent 4 pushes the staged publish package to a review
# branch and opens a PR — it never writes straight to the default branch.
GITHUB_TOKEN=
GITHUB_REPO=                      # "owner/repo"
GITHUB_DEFAULT_BRANCH=main
# GITHUB_CONTENT_PREFIX=seo-automation/publish_package   # optional override

# --- Google services (dashboard's real-data panels + real sitemap submit) ---
# See README.md "Google services setup" for exactly how to get each of these.

# PageSpeed Insights — just an API key (PageSpeed Insights API enabled on a
# Google Cloud project).
GOOGLE_PAGESPEED_API_KEY=

# Chrome UX Report — a separate API key (Chrome UX Report API enabled on
# the same or another GCP project).
GOOGLE_CRUX_API_KEY=

# Search Console + GA4 both authenticate via one service-account JSON key.
# Put the downloaded file at credentials/google-service-account.json (that
# folder is gitignored) and point this at it.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# The exact property string as Search Console shows it: sc-domain:darwix.ai
# for a Domain property, or the full https://darwix.ai/ URL for a
# URL-prefix property.
GSC_SITE_URL=sc-domain:darwix.ai

# GA4 property id — numbers only, from Admin > Property details.
GA4_PROPERTY_ID=

# Optional — override if darwix.ai's GA4 property uses different custom
# event names for these three funnel steps.
# GA4_EVENT_CTA_CLICK=cta_click
# GA4_EVENT_FORM_START=form_start
# GA4_EVENT_DEMO_REQUEST=demo_request
